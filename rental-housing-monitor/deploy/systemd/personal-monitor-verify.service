[Unit]
Description=Weekly personal monitor local staging restore verification
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/personal-monitor/app/scripts/backup_personal_monitor.sh
ConditionPathExists=/srv/personal-monitor/.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/srv/personal-monitor/.env
ExecStart=/srv/personal-monitor/app/scripts/backup_personal_monitor.sh
TimeoutStartSec=1800
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
